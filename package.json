{
  "name": "awesome-jev",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-static-site.mjs && node scripts/finalize-pages.mjs && node scripts/audit-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "radar": "node scripts/radar-sync.mjs",
    "test": "node --test scripts/*.test.mjs test/*.test.mjs",
    "pretest": "node scripts/prepare-public-data.mjs && node scripts/generate-readme.mjs",
    "predev": "node scripts/prepare-public-data.mjs && node scripts/generate-readme.mjs",
    "prebuild": "node scripts/prepare-public-data.mjs && node scripts/generate-readme.mjs",
    "sync:avatars": "node scripts/sync-avatars.mjs",
    "build:readme": "node scripts/generate-readme.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "lucide-react": "^0.468.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.3",
    "vite": "^7.1.5",
    "typescript": "^5.9.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@playwright/test": "^1.55.0"
  }
}
